{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "unique_id_mismatch": "The Ampio server reported a different identity than the one originally configured."
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "no_server_info": "Could not read the server identity. Your account must have permission to read the Ampio configuration."
    },
    "flow_title": "Ampio M-SERV ({name})",
    "step": {
      "reauth_confirm": {
        "data": {
          "password": "[%key:common::config_flow::data::password%]",
          "username": "[%key:common::config_flow::data::username%]"
        },
        "data_description": {
          "password": "[%key:component::ampio::config::step::user::data_description::password%]",
          "username": "[%key:component::ampio::config::step::user::data_description::username%]"
        },
        "description": "The stored credentials for your Ampio server were rejected. Enter the current username and password to keep the integration connected.",
        "title": "Re-authenticate with Ampio"
      },
      "reconfigure": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "password": "[%key:common::config_flow::data::password%]",
          "port": "[%key:common::config_flow::data::port%]",
          "username": "[%key:common::config_flow::data::username%]"
        },
        "data_description": {
          "host": "[%key:component::ampio::config::step::user::data_description::host%]",
          "password": "[%key:component::ampio::config::step::user::data_description::password%]",
          "port": "[%key:component::ampio::config::step::user::data_description::port%]",
          "username": "[%key:component::ampio::config::step::user::data_description::username%]"
        },
        "description": "Change how Home Assistant connects to your Ampio server. The server must be the same one you originally configured.",
        "title": "Reconfigure Ampio"
      },
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "password": "[%key:common::config_flow::data::password%]",
          "port": "[%key:common::config_flow::data::port%]",
          "username": "[%key:common::config_flow::data::username%]"
        },
        "data_description": {
          "host": "Hostname or IP address of the Ampio server (M-SERV).",
          "password": "Your Ampio account password.",
          "port": "MQTT port of the Ampio server (default 1883).",
          "username": "Your Ampio account username."
        },
        "description": "Enter the address and credentials of your Ampio server.",
        "title": "Connect to Ampio"
      }
    }
  },
  "entity": {
    "sensor": {
      "co2": {
        "name": "CO2"
      },
      "humidity": {
        "name": "Humidity"
      },
      "iaq": {
        "name": "Air quality index"
      },
      "illuminance": {
        "name": "Illuminance"
      },
      "loudness": {
        "name": "Loudness"
      },
      "module_last_seen": {
        "name": "Last seen"
      },
      "pressure_abs": {
        "name": "Absolute pressure"
      },
      "pressure_rel": {
        "name": "Relative pressure"
      },
      "temperature": {
        "name": "Temperature"
      }
    }
  },
  "exceptions": {
    "cannot_connect": {
      "message": "Cannot connect to the Ampio server."
    },
    "invalid_auth": {
      "message": "The Ampio server rejected the stored credentials."
    }
  }
}
